# Local development only. Copy to .env and set a local password before startup.
POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
APP_TIMEZONE=UTC
FRONTEND_PORT=5173
API_PORT=8000
# Used by Vite inside Compose; browser requests use the same-origin /health proxy.
API_PROXY_TARGET=http://api:8000
# Explicitly opt into the separate development seed CLI.
APP_ENV=development
# Generate locally: openssl rand -hex 32; never commit.
AUTH_SECRET=
# Set explicit HTTPS origins for production; defaults cover local ports.

# Optional ingestion profile: set to `id -u` / `id -g` for the local sftp bind mount.
INTAKE_UID=
INTAKE_GID=

# Export worker uses INTAKE_UID/INTAKE_GID for the local download directory.
# Host-only API/worker: EXPORT_ROOT=/absolute/path/to/sftp/download
