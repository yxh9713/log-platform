# Host-only alternative: PostgreSQL and Redis must be reachable at these URLs.
DATABASE_URL=postgresql://logistics:replace-with-local-password@127.0.0.1:5432/logistics
REDIS_URL=redis://127.0.0.1:6379/0
APP_TIMEZONE=UTC
# Explicitly opt into the separate development seed CLI.
APP_ENV=development
# Generate locally: openssl rand -hex 32; never commit.
AUTH_SECRET=
# Set explicit HTTPS origins for production; defaults cover local ports.
